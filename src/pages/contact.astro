---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { person, site } from '../data/site';
import { photos } from '../data/photos';

const title = 'Book a Channel Strategy Call | Travis Woods';
const description = 'Book a 30-minute channel strategy call with Travis Woods about where your MSP partners stall and how to get them selling. Schedule directly or connect on LinkedIn.';
---
<Base title={title} description={description} pageType="ContactPage" crumbs={[{ name: 'Contact', path: '/contact/' }]}>
  <header class="page-head">
    <div class="wrap grid-2 grid-2--wide-left">
      <div>
        <h1>Let&rsquo;s talk</h1>
        <p class="lead">Start with a 30-minute call about where your MSP partners stall and what it would take to get them selling. Bring your partner numbers and your current pitch.</p>
        <ul class="ways">
          <li>
            <h2>Book a channel strategy call</h2>
            <p>Strategy calls and speaking inquiries, scheduled on Travis&rsquo;s calendar.</p>
            <a class="btn btn--primary" href={person.bookingUrl}>Open the calendar</a>
          </li>
          <li>
            <h2>Connect on LinkedIn</h2>
            <p><a href={person.linkedin} rel="me">linkedin.com/in/traviswoods</a></p>
          </li>
        </ul>
        {site.openToExecutiveRoles && (
          <p class="roles">Recruiters and hiring leaders: Travis is open to conversations about vendor-side channel executive roles, such as VP of Channel, Head of MSP, or Chief MSP Officer.</p>
        )}
      </div>
      <Photo photo={photos.glasses} loading="eager" aspect="4/5" sizes="(min-width: 880px) 40vw, 100vw" widths={[480, 800, 1100]} />
    </div>
  </header>
</Base>

<style>
  .ways { list-style: none; padding: 0; margin: 2rem 0; border-top: 2px solid var(--navy); }
  .ways li { padding: 1.25rem 0; border-bottom: 1px solid var(--rule); margin: 0; }
  .ways h2 { font-size: var(--s1); margin-bottom: 0.25rem; }
  .ways p { margin-bottom: 0.75rem; }
  .roles { border-left: 4px solid var(--teal); padding-left: 1rem; color: var(--muted); }
</style>
