---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ClarityRings from '../components/ClarityRings.astro';
import CallToAction from '../components/CallToAction.astro';
import { site, person, results, process, advisory, speaking, problems, outcomes, services, whoFor } from '../data/site';
import { photos } from '../data/photos';

const title = site.title;
const description = site.description;
const currentBoards = advisory.filter((a) => a.current).map((a) => a.org.replace(/ \(.*\)$/, ''));
---
<Base title={title} description={description} pageType="WebPage">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker">For cybersecurity, AI, and IT vendors selling through MSPs</p>
        <h1 class="statement">Get MSPs selling your product, not just signing up.</h1>
        <p class="lead">You built a strong product. Now you need MSPs to package it, price it, and sell it with margin. I help vendors build the partner value story, onboarding, and co-sell motion that move partners from signed to selling, faster.</p>
        <div class="actions">
          <a class="btn btn--primary" href={person.bookingUrl}>Book a channel strategy call</a>
          <a class="btn btn--ghost" href="/services/">See how it works</a>
        </div>
      </div>
      <div class="hero-media">
        <Photo photo={photos.studio} loading="eager" sizes="(min-width: 880px) 45vw, 100vw" widths={[480, 720, 960, 1280]} aspect="4/5" />
        <div class="lower-third" aria-hidden="true">
          <span class="lt-name">Travis Woods</span><span class="lt-role">Ran an MSP for 16 years. Now builds vendor channel programs.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="problems-h">
    <div class="wrap">
      <h2 id="problems-h">Sound familiar?</h2>
      <p class="lead">Strong products stall in the MSP channel for the same handful of reasons. None of them are about the technology.</p>
      <ul class="problems">
        {problems.map((p) => (
          <li><h3>{p.title}</h3><p>{p.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section problem">
    <div class="wrap grid-2">
      <div>
        <h2>MSPs back the vendors who make them money</h2>
        <p class="lead">An MSP puts its own client relationships behind every product it sells. It backs the vendors that are easy to explain, easy to package, and profitable to deliver. Everything else sits unused in the portal.</p>
        <p>Fixing that is not about more tiers or a bigger partner portal. It is about seeing your program the way an MSP owner sees it, then rebuilding the story, the offer, and the motion around what makes them say yes.</p>
      </div>
      <Photo photo={photos.canalysPanel} showCaption sizes="(min-width: 880px) 50vw, 100vw" />
    </div>
  </section>

  <section class="section section--white" aria-labelledby="outcomes-h">
    <div class="wrap grid-2 grid-2--wide-left">
      <div>
        <h2 id="outcomes-h">What you walk away with</h2>
        <ul class="outcomes">{outcomes.map((o) => <li>{o}</li>)}</ul>
      </div>
      <div class="who">
        <h3>Built for</h3>
        <ul>{whoFor.map((w) => <li>{w}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="process-h">
    <div class="wrap">
      <h2 id="process-h">How we get there: the Channel Clarity Process</h2>
      <p class="lead">Three steps, in order. Most programs skip straight to activation and wonder why it doesn&rsquo;t stick.</p>
      <div class="rings-wrap"><ClarityRings /></div>
      <ol class="steps">
        {process.map((p) => (
          <li class={`step step--${p.color}`}>
            <span class="step-num" aria-hidden="true">{p.step}</span>
            <h3>{p.name}</h3>
            <p class="step-sum">{p.summary}</p>
            <ul>{p.points.slice(0, 4).map((pt) => <li>{pt}</li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="ways-h">
    <div class="wrap">
      <h2 id="ways-h">Ways to work together</h2>
      <dl class="offers">
        {services.map((s) => (
          <div><dt>{s.name}</dt><dd>{s.text}</dd></div>
        ))}
      </dl>
      <p><a href="/services/">See what each engagement includes</a></p>
    </div>
  </section>

  <section class="section results" aria-labelledby="why-h">
    <div class="wrap grid-2">
      <div>
        <h2 id="why-h">Why it works: I&rsquo;ve sat in your partner&rsquo;s chair</h2>
        <p>For 16 years I ran Fort Point IT, a managed IT and cybersecurity provider. I chose vendors, worked their MDF and onboarding, and decided which ones earned a place in my stack. The motions I build for vendors are the ones that won my business.</p>
        <ul class="figures">
          {results.map((r) => <li><strong>{r.figure}</strong> <span>{r.label}</span></li>)}
        </ul>
        <p class="creds">Advisory boards: {currentBoards.join(', ')}. Spoken at {speaking.stages.slice(0, 4).join(', ')}.</p>
        <p><a href="/about/">More on my background</a></p>
      </div>
      <Photo photo={photos.keynoteNexgen} showCaption aspect="1/1" />
    </div>
  </section>

  <CallToAction />
</Base>

<style>
  .hero { background: var(--white); padding: clamp(2rem, 6vw, 4.5rem) 0 clamp(3rem, 7vw, 5rem); overflow: hidden; }
  .hero-grid { display: grid; gap: 2.5rem; grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 880px) { .hero-grid { grid-template-columns: 1.15fr 1fr; gap: 4rem; } }
  .kicker { font-family: var(--display); font-weight: 700; color: var(--teal); text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.85rem; margin: 0 0 1rem; }
  .statement {
    font-family: var(--display); font-size: var(--s5); font-weight: 800; line-height: 1.02;
    font-variation-settings: 'wdth' 76; color: var(--navy); letter-spacing: -0.015em;
    margin: 0 0 1.5rem; max-width: 15ch; text-wrap: balance;
  }
  .hero .lead { max-width: 46ch; }
  .hero-media { position: relative; }
  .hero-media :global(img) { filter: contrast(1.05); }

  /* The broadcast-style lower third */
  .lower-third { position: absolute; left: -0.75rem; right: 12%; bottom: 1.75rem; display: grid; animation: lt-in 700ms cubic-bezier(.2,.7,.2,1) 250ms both; }
  .lt-name {
    background: var(--navy); color: #fff; font-family: var(--display); font-size: clamp(1.6rem, 3.6vw, 2.4rem); font-weight: 800;
    font-variation-settings: 'wdth' 82; padding: 0.55rem 1.1rem 0.5rem 1.4rem; border-left: 10px solid var(--red); line-height: 1.05;
  }
  .lt-role {
    background: var(--white); color: var(--navy); font-family: var(--display); font-size: clamp(0.9rem, 1.6vw, 1.05rem); font-weight: 600;
    font-variation-settings: 'wdth' 95; padding: 0.45rem 1.1rem 0.45rem 1.4rem; border-left: 10px solid var(--teal); width: fit-content; max-width: 100%;
  }
  @keyframes lt-in { from { transform: translateX(-24px); opacity: 0; } to { transform: none; opacity: 1; } }

  .problems { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 0 2.5rem; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .problems { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1040px) { .problems { grid-template-columns: repeat(3, 1fr); } }
  .problems li { margin: 0; padding: 1.25rem 0 1rem; border-top: 4px solid var(--red); }
  .problems h3 { font-size: var(--s1); margin-bottom: 0.35rem; }
  .problems p { margin: 0; color: var(--muted); }

  .outcomes { list-style: none; padding: 0; margin: 1.5rem 0 0; border-top: 2px solid var(--navy); }
  .outcomes li { margin: 0; padding: 0.85rem 0 0.85rem 2rem; border-bottom: 1px solid var(--rule); position: relative; font-size: 1.08rem; }
  .outcomes li::before { content: ''; position: absolute; left: 0.2rem; top: 1.15rem; width: 0.9rem; height: 0.45rem; border-left: 3px solid var(--teal); border-bottom: 3px solid var(--teal); transform: rotate(-45deg); }
  .who { background: var(--mist); padding: 1.5rem 1.75rem; align-self: start; }
  .who h3 { margin-top: 0; }
  .who ul { padding-left: 1.1em; margin: 0; }
  .who li { margin-bottom: 0.5rem; }

  .rings-wrap { margin: 2rem 0 2.5rem; }
  .steps { list-style: none; padding: 0; margin: 0 0 1rem; display: grid; gap: 1.5rem; grid-template-columns: 1fr; }
  @media (min-width: 880px) { .steps { grid-template-columns: repeat(3, 1fr); gap: 2.5rem; } }
  .step { border-top: 6px solid var(--c); padding-top: 1.25rem; margin: 0; }
  .step--navy { --c: var(--navy); } .step--red { --c: var(--red); } .step--teal { --c: var(--teal); }
  .step-num { font-family: var(--display); font-weight: 800; font-size: 3rem; line-height: 1; color: var(--c); font-variation-settings: 'wdth' 75; }
  .step h3 { margin-top: 0.4rem; margin-bottom: 0.25rem; }
  .step-sum { font-style: italic; color: var(--muted); }
  .step ul { padding-left: 1.1em; font-size: 0.98rem; }

  .offers { margin: 2rem 0 1.5rem; display: grid; grid-template-columns: 1fr; gap: 0 3rem; }
  @media (min-width: 760px) { .offers { grid-template-columns: 1fr 1fr; } }
  .offers div { padding: 1.25rem 0; border-top: 1px solid var(--rule); }
  .offers dt { font-family: var(--display); font-weight: 700; font-size: var(--s1); color: var(--navy); margin-bottom: 0.3rem; }
  .offers dd { margin: 0; }

  .figures { list-style: none; padding: 0; margin: 1.5rem 0; }
  .figures li { display: grid; gap: 0.15rem; padding: 0.9rem 0; border-bottom: 1px solid var(--rule); margin: 0; }
  .figures strong { font-family: var(--display); font-size: var(--s3); color: var(--red); font-variation-settings: 'wdth' 76; line-height: 1.05; }
  .creds { color: var(--muted); font-size: 0.98rem; }
</style>
