---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ClarityRings from '../components/ClarityRings.astro';
import CallToAction from '../components/CallToAction.astro';
import { site, person, results, process, advisory, speaking, travel } from '../data/site';
import { photos } from '../data/photos';

const title = site.title;
const description = site.description;
---
<Base title={title} description={description} pageType="WebPage">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="statement">I ran an MSP for 16 years. Now I help vendors earn the channel&rsquo;s trust.</p>
        <p class="lead">Partner programs fail when MSPs don&rsquo;t understand the story or don&rsquo;t believe it. I build channel go-to-market from the partner&rsquo;s side of the table, because that&rsquo;s where I sat.</p>
        <div class="actions">
          <a class="btn btn--primary" href={person.bookingUrl}>Book a consultation</a>
          <a class="btn btn--ghost" href="/speaking/">Book a speaking engagement</a>
        </div>
      </div>
      <div class="hero-media">
        <Photo photo={photos.studio} loading="eager" sizes="(min-width: 880px) 45vw, 100vw" widths={[480, 720, 960, 1280]} aspect="4/5" />
        <div class="lower-third">
          <h1><span class="lt-name">Travis Woods</span><span class="lt-role">Channel strategist and former MSP owner</span></h1>
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight section--white glance" aria-labelledby="glance-h">
    <div class="wrap grid-2 grid-2--wide-left">
      <div>
        <h2 id="glance-h" class="h-sm">Who is Travis Woods?</h2>
        <p>{person.definition}</p>
      </div>
      <dl class="facts">
        <div><dt>Based in</dt><dd>{person.location}</dd></div>
        <div><dt>Operator background</dt><dd>Founder and CEO, Fort Point IT, 2009 to 2025</dd></div>
        <div><dt>Works with</dt><dd>Cybersecurity, AI, cyber insurance, and IT vendors selling through MSPs</dd></div>
        <div><dt>Advisory boards</dt><dd>The Channel Company XChange, GTIA, HENNGE North America, Theo AI</dd></div>
        <div><dt>Markets</dt><dd>North America and Latin America</dd></div>
      </dl>
    </div>
  </section>

  <section class="section problem">
    <div class="wrap grid-2">
      <div>
        <h2>Your partners can&rsquo;t sell a story they don&rsquo;t understand</h2>
        <p class="lead">Plenty of strong technology companies struggle to explain how they help MSPs grow. When the value story isn&rsquo;t simple, partners hesitate, sellers drift out of alignment, and programs stall.</p>
        <p>You can sign partners all day. If they aren&rsquo;t engaging, you aren&rsquo;t driving revenue. I&rsquo;ve watched this from inside an MSP: the vendors who won my business made it easy to package, price, and sell their product with margin. The ones who didn&rsquo;t sat unused in the portal.</p>
      </div>
      <Photo photo={photos.canalysPanel} showCaption sizes="(min-width: 880px) 50vw, 100vw" />
    </div>
  </section>

  <section class="section section--white" aria-labelledby="process-h">
    <div class="wrap">
      <h2 id="process-h">The Channel Clarity Process</h2>
      <p class="lead">Three steps, in order. Most programs skip straight to activation and wonder why it doesn&rsquo;t stick.</p>
      <div class="rings-wrap"><ClarityRings /></div>
      <ol class="steps">
        {process.map((p) => (
          <li class={`step step--${p.color}`}>
            <span class="step-num" aria-hidden="true">{p.step}</span>
            <h3>{p.name}</h3>
            <p class="step-sum">{p.summary}</p>
            <ul>{p.points.slice(0, 4).map((pt) => <li>{pt}</li>)}</ul>
          </li>
        ))}
      </ol>
      <p><a href="/services/">See how the process turns into an engagement</a></p>
    </div>
  </section>

  <section class="section results" aria-labelledby="results-h">
    <div class="wrap grid-2">
      <div>
        <h2 id="results-h">Proof from the operator&rsquo;s seat</h2>
        <p>Before advising vendors, I built the motions I now recommend, inside my own MSP and with my own vendor partners.</p>
        <ul class="figures">
          {results.map((r) => <li><strong>{r.figure}</strong> <span>{r.label}</span></li>)}
        </ul>
        <p><a href="/about/">Read the full background</a></p>
      </div>
      <Photo photo={photos.keynoteNexgen} showCaption aspect="1/1" />
    </div>
  </section>

  <section class="section section--white" aria-labelledby="speak-h">
    <div class="wrap">
      <div class="grid-2">
        <div>
          <h2 id="speak-h">On stage and in the room</h2>
          <p class="lead">Keynotes, panels, and focus groups on channel strategy, MSP evolution, and cybersecurity go-to-market. Candid, practical, and grounded in what MSPs actually do.</p>
          <p class="stages">Spoken at {speaking.stages.slice(0, -1).join(', ')}, and the {speaking.stages.at(-1)}.</p>
          <div class="actions"><a class="btn btn--ghost" href="/speaking/">Speaking topics</a></div>
        </div>
        <div class="mosaic">
          <Photo photo={photos.xchangeStage} sizes="(min-width: 880px) 25vw, 50vw" widths={[400, 800]} aspect="4/3" />
          <Photo photo={photos.aiWorkshop} sizes="(min-width: 880px) 25vw, 50vw" widths={[400, 800]} aspect="4/3" />
          <Photo photo={photos.managedServices} sizes="(min-width: 880px) 25vw, 50vw" widths={[400, 800]} aspect="4/3" />
          <Photo photo={photos.xchangePanel} sizes="(min-width: 880px) 25vw, 50vw" widths={[400, 800]} aspect="4/3" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="boards-h">
    <div class="wrap grid-2">
      <Photo photo={photos.channelCoBoard} showCaption />
      <div>
        <h2 id="boards-h">Trusted by the people who shape the channel</h2>
        <ul class="boards">
          {advisory.map((a) => <li><strong>{a.org}</strong><span>{a.role}</span></li>)}
        </ul>
        <p><a href="/advisory-boards/">Advisory boards and memberships</a></p>
      </div>
    </div>
  </section>

  <section class="section section--white global" aria-labelledby="global-h">
    <div class="wrap grid-2 grid-2--wide-left">
      <div>
        <h2 id="global-h">Connecting the channel, one country at a time</h2>
        <p>A change of latitude sparks new ideas. I work with partners, distributors, and public sector leaders across North America and Latin America, including cybersecurity and Smart City projects in Colombia.</p>
        <p class="travel-label">{travel.label}</p>
        <ul class="travel">
          {travel.stats.map((s) => <li><strong>{s.figure}</strong> <span>{s.label}</span></li>)}
        </ul>
      </div>
      <Photo photo={photos.foroColombia} showCaption />
    </div>
  </section>

  <CallToAction />
</Base>

<style>
  .hero { background: var(--white); padding: clamp(2rem, 6vw, 4.5rem) 0 clamp(3rem, 7vw, 5rem); overflow: hidden; }
  .hero-grid { display: grid; gap: 2.5rem; grid-template-columns: 1fr; align-items: center; }
  @media (min-width: 880px) { .hero-grid { grid-template-columns: 1.15fr 1fr; gap: 4rem; } }
  .statement {
    font-family: var(--display); font-size: var(--s5); font-weight: 800; line-height: 1.02;
    font-variation-settings: 'wdth' 76; color: var(--navy); letter-spacing: -0.015em;
    margin: 0 0 1.5rem; max-width: 15ch; text-wrap: balance;
  }
  .hero .lead { max-width: 46ch; }
  .hero-media { position: relative; }
  .hero-media :global(img) { filter: contrast(1.05); }

  /* The broadcast-style lower third */
  .lower-third { position: absolute; left: -0.75rem; right: 12%; bottom: 1.75rem; animation: lt-in 700ms cubic-bezier(.2,.7,.2,1) 250ms both; }
  .lower-third h1 { margin: 0; display: grid; }
  .lt-name {
    background: var(--navy); color: #fff; font-size: clamp(1.6rem, 3.6vw, 2.4rem); font-weight: 800;
    font-variation-settings: 'wdth' 82; padding: 0.55rem 1.1rem 0.5rem 1.4rem; border-left: 10px solid var(--red); line-height: 1.05;
  }
  .lt-role {
    background: var(--white); color: var(--navy); font-size: clamp(0.9rem, 1.6vw, 1.05rem); font-weight: 600;
    font-variation-settings: 'wdth' 95; padding: 0.45rem 1.1rem 0.45rem 1.4rem; border-left: 10px solid var(--teal); width: fit-content; max-width: 100%;
  }
  @keyframes lt-in { from { transform: translateX(-24px); opacity: 0; } to { transform: none; opacity: 1; } }

  .h-sm { font-size: var(--s2); }
  .glance p { font-size: var(--s1); line-height: 1.55; }
  .facts { margin: 0; display: grid; gap: 0; border-top: 2px solid var(--navy); }
  .facts div { padding: 0.7rem 0; border-bottom: 1px solid var(--rule); display: grid; grid-template-columns: 9.5rem 1fr; gap: 1rem; }
  .facts dt { font-family: var(--display); font-weight: 700; color: var(--navy); font-size: 0.95rem; }
  .facts dd { margin: 0; }
  @media (max-width: 520px) { .facts div { grid-template-columns: 1fr; gap: 0.1rem; } }

  .rings-wrap { margin: 2rem 0 2.5rem; }
  .steps { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; gap: 1.5rem; grid-template-columns: 1fr; counter-reset: none; }
  @media (min-width: 880px) { .steps { grid-template-columns: repeat(3, 1fr); gap: 2.5rem; } }
  .step { border-top: 6px solid var(--c); padding-top: 1.25rem; margin: 0; }
  .step--navy { --c: var(--navy); } .step--red { --c: var(--red); } .step--teal { --c: var(--teal); }
  .step-num { font-family: var(--display); font-weight: 800; font-size: 3rem; line-height: 1; color: var(--c); font-variation-settings: 'wdth' 75; }
  .step h3 { margin-top: 0.4rem; margin-bottom: 0.25rem; }
  .step-sum { font-style: italic; color: var(--muted); }
  .step ul { padding-left: 1.1em; font-size: 0.98rem; }

  .figures { list-style: none; padding: 0; margin: 1.5rem 0; }
  .figures li { display: grid; gap: 0.15rem; padding: 0.9rem 0; border-bottom: 1px solid var(--rule); margin: 0; }
  .figures strong { font-family: var(--display); font-size: var(--s3); color: var(--red); font-variation-settings: 'wdth' 76; line-height: 1.05; }

  .stages { font-family: var(--display); font-weight: 600; color: var(--navy); }
  .mosaic { display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem; }

  .boards { list-style: none; padding: 0; margin: 0 0 1.5rem; border-top: 2px solid var(--navy); }
  .boards li { padding: 0.75rem 0; border-bottom: 1px solid var(--rule); display: grid; margin: 0; }
  .boards strong { font-family: var(--display); color: var(--navy); }
  .boards span { color: var(--muted); font-size: 0.95rem; }

  .travel-label { font-family: var(--display); font-weight: 600; color: var(--teal); margin-top: 1.5rem; margin-bottom: 0.5rem; }
  .travel { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 2.5rem; }
  .travel strong { display: block; font-family: var(--display); font-size: var(--s3); color: var(--navy); font-variation-settings: 'wdth' 78; line-height: 1.1; }
  .travel span { font-family: var(--display); color: var(--muted); font-size: 0.95rem; }
</style>
