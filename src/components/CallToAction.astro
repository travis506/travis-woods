---
import { person } from '../data/site';
interface Props { heading?: string; text?: string }
const {
  heading = 'Want MSPs to actually sell your product?',
  text = 'Start with a 30-minute conversation about where your partners stall and what it would take to get them moving.',
} = Astro.props;
---
<section class="section section--navy cta">
  <div class="wrap">
    <h2>{heading}</h2>
    <p class="lead">{text}</p>
    <div class="actions">
      <a class="btn btn--primary" href={person.bookingUrl}>Book a consultation</a>
      <a class="btn btn--ghost" href="/speaking/">Book Travis to speak</a>
    </div>
  </div>
</section>
<style>
  .cta .lead { color: #dfe8f1; max-width: 52ch; }
  .cta h2 { max-width: 20ch; }
</style>
